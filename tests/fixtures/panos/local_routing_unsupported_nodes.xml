<config>
  <devices>
    <entry name="localhost.localdomain">
      <network>
        <virtual-router>
          <entry name="unsupported-vr">
            <ecmp>
              <enable>yes</enable>
            </ecmp>
            <routing-table>
              <ip>
                <static-route>
                  <entry name="qualified-route">
                    <destination>203.0.113.0/24</destination>
                    <nexthop>
                      <qualified-next-hop>
                        <entry name="203.0.113.1">
                          <metric>10</metric>
                        </entry>
                      </qualified-next-hop>
                    </nexthop>
                  </entry>
                </static-route>
              </ip>
            </routing-table>
          </entry>
        </virtual-router>
      </network>
    </entry>
  </devices>
</config>
